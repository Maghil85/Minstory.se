# Server-side miljövariabler — kopiera till .env och fyll i dina värden
# Dessa exponeras ALDRIG till klienten (inget VITE_-prefix)

# Din OpenAI API-nyckel (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...

# URL till backend Express-servern (Railway-URL i produktion, tom = localhost i dev)
# Exempel: VITE_API_URL=https://minstory-backend.up.railway.app
VITE_API_URL=

# Tillåten origin för CORS — kommaseparera flera (localhost + produktion)
# Exempel: ALLOWED_ORIGIN=http://localhost:5173,https://minstory.se,https://www.minstory.se
ALLOWED_ORIGIN=http://localhost:5173

# Porten som Express-servern lyssnar på (valfritt, standard 3001)
PORT=3001

# ── Firebase (frontend) — projekt: MinStory (minstory-39d77) ─────────────────
# Hämta från: Firebase Console → minstory-39d77 → Projektinställningar → Dina appar → Webbapp
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=minstory-39d77.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=minstory-39d77
VITE_FIREBASE_STORAGE_BUCKET=minstory-39d77.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=440242998625
VITE_FIREBASE_APP_ID=1:440242998625:web:abc123

# ── Swish-betalning (frontend) ────────────────────────────────────────────────
# Swish-nummer och visningsnamn för Bokarent Sverige
VITE_SWISH_NUMBER=123 094 78 87
VITE_SWISH_NAME=Bokarent Sverige AB

# ── Stability AI (server) — för img2img med kundens foto ─────────────────────
# Hämta nyckel från https://platform.stability.ai/account/keys
# Utan denna nyckel faller servern tillbaka på DALL-E 3
STABILITY_API_KEY=sk-...

# ── Firebase Storage (server) — permanent bildlagring ────────────────────────
# Utan dessa sparas DALL-E-URLer temporärt (~1h) och Stability-bilder som base64 i Firestore.
#
# FIREBASE_STORAGE_BUCKET: Samma som VITE_FIREBASE_STORAGE_BUCKET ovan
# FIREBASE_SERVICE_ACCOUNT_JSON: Firebase Console → minstory-39d77 →
#   Projektinställningar → Tjänstekonton → Generera ny privat nyckel (JSON-fil)
#   Klistra in hela JSON-innehållet som en rad
#
FIREBASE_STORAGE_BUCKET=minstory-39d77.appspot.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"minstory-39d77",...}
